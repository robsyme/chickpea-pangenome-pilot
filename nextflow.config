manifest {
    name            = 'chickpea-stlfr-gate-zero'
    author          = 'robsyme'
    description      = 'stLFR barcode-integrity gate-zero check for chickpea pan-genome reassembly pilot'
    // >=26.04.4: needs the fix for staging record Path-field inputs under Fusion
    // with module binaries enabled (nextflow-io/nextflow#7226).
    nextflowVersion  = '>=26.04.4'
}

// NOTE: infrastructure-specific settings are deliberately NOT in this repo — they
// live on the Seqera Platform Launchpad pipeline / compute environment, to keep the
// workflow portable. That includes `outputDir` (the S3 results prefix), the work
// directory, and allowed S3 buckets. For a local run, pass `-output-dir <path>`.

// Retry transient failures (e.g. spot reclamation, Fusion visibility races on
// freshly-written objects). These are directives, not part of the task cache hash,
// so adding them does not invalidate resumed/cached tasks.
process {
    errorStrategy = 'retry'
    maxRetries    = 2
}

// AWS Batch queue routing (infra-agnostic): the actual queue NAMES are our
// infrastructure, so they are NOT committed here — they are supplied at launch via
// `--params-file` (like outputDir/work-dir live on the Launchpad, not in the repo).
// Empty defaults mean "use the compute environment's default queue", so the repo
// still runs unchanged on someone else's infra.
//
// Why: long, largely single-threaded steps (the full-run download, stLFR barcode
// conversion, and the ABySS assembly) get reclaimed mid-run on Spot, and Fusion
// Snapshots' restore then fails (exit 175, dumprestore.c:384). Routing just those
// steps to an on-demand queue avoids reclamation, while everything else stays on the
// cheap Spot default queue. `queue` is a directive, not part of the task hash, so
// adding this does not invalidate resumed/cached tasks.
params {
    queue_spot     = null   // e.g. 'TowerForge-<spotCeId>-work' (optional)
    queue_ondemand = null   // e.g. 'TowerForge-<ondemandCeId>'  (the long-task queue)
}

process {
    // Long tasks → on-demand when a queue is provided; otherwise CE default.
    withName: 'FETCH_FULL_READS|LRTK_CONVERT|ABYSS' {
        queue = { params.queue_ondemand ?: params.queue_spot }
    }
    // Optional Spot→on-demand failover for the cheap tasks (off unless both queues
    // are set): uncomment to try Spot first and retry on on-demand.
    // queue = { params.queue_ondemand && task.attempt > 1 ? params.queue_ondemand : params.queue_spot }
}

// NOTE: the typed syntax requires the strict v2 parser, which is selected by the
// NXF_SYNTAX_PARSER=v2 environment variable. That variable is read before this
// config is parsed, so it cannot be set here — set it on the Seqera Platform
// compute environment (env var) or export it locally before launching.

// Local-only convenience profile. On Seqera Platform, Wave + Fusion + the conda
// directive build/resolve containers via the compute environment, so no engine is
// set here for the default profile.
profiles {
    local_conda {
        conda.enabled = true
    }

    // Cap the assembly step's resource request so the whole pipeline can be validated
    // locally in stub mode. ABYSS requests 16 CPU / 64 GB for production; this withName
    // selector overrides that only when the profile is active. Production runs (no
    // profile) keep the real request. Resource directives are not part of the task hash.
    stub_local {
        process {
            withName: ABYSS {
                cpus   = 2
                memory = 2.GB
            }
        }
    }
}
